# Production build config — picfix.duckdns.org
# Convention (lib/config.ts): API ROOT without the /api prefix;
# lib/api.ts appends "/api/..." endpoint paths itself.
NEXT_PUBLIC_API_URL=https://picfix.duckdns.org
# Must match backend MAX_FILE_SIZE (15MB) — client-side pre-upload validation.
NEXT_PUBLIC_MAX_FILE_SIZE_BYTES=15728640
