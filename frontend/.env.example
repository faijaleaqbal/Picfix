# Frontend environment template — copy to .env.local (dev) or set at deploy time.

# Backend API base URL.
# Convention: NO trailing /api prefix — the shared client (lib/api.ts)
# appends "/api/..." endpoint paths itself. Examples:
#   dev:      http://localhost:4100   (4000 is occupied on this machine)
#   prod:     https://api.luminaedit.example.com   (or same-origin "")
NEXT_PUBLIC_API_URL=http://localhost:4100

# Max upload size in BYTES. Must match the backend's MAX_FILE_SIZE
# so oversized files are rejected in the browser before uploading.
# 15MB = 15728640
NEXT_PUBLIC_MAX_FILE_SIZE_BYTES=15728640
