{
  "name": "image-editor-backend",
  "version": "1.0.0",
  "description": "Pure REST API backend for an all-in-one online image editing tool. Includes BullMQ queue + Redis-backed rate limiting for AI microservices.",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "check": "node scripts/syntax-check.js",
    "worker": "node src/worker.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "loadtest": "node test/load/load-test.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bullmq": "^5.34.0",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.1",
    "form-data": "^4.0.1",
    "heic-convert": "^2.1.0",
    "ioredis": "^5.4.2",
    "multer": "^2.3.0",
    "node-cron": "^3.0.3",
    "pdf-lib": "^1.17.1",
    "rate-limit-redis": "^4.2.0",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "supertest": "^7.0.0",
    "vitest": "^2.1.8"
  }
}
