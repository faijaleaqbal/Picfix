# Server
# NOTE: 4000 was the original convention but is occupied on this machine
# (litellm proxy); 4100 is the working local value. Frontend
# NEXT_PUBLIC_API_URL must match.
PORT=4100
NODE_ENV=development

# Temp storage
TEMP_DIR=/tmp/image-uploads

# Upload limits (bytes) - 15MB default
MAX_FILE_SIZE=15728640

# File TTL & cleanup
FILE_TTL_MINUTES=30
CLEANUP_INTERVAL_MINUTES=5

# Sharp concurrency (concurrent heavy ops)
SHARP_CONCURRENCY=4
# libvips internal thread pool (set to CPU cores for 2 vCPU)
LIBVIPS_CONCURRENCY=2

# Queue timeout before 503 (ms) - used by the in-memory sharp semaphore
QUEUE_TIMEOUT_MS=30000

# Max images per PDF
MAX_IMAGES_PER_PDF=20

# Future AI microservice base URL (stub routes document the contract)
AI_SERVICE_URL=http://ai-service:8000

# ---- CORS ----
# Comma-separated list of allowed browser origins.
# CORS_ORIGIN is the primary origin (frontend dev server).
CORS_ORIGIN=http://localhost:3000
# CORS_ORIGINS may hold extra origins, comma-separated:
# CORS_ORIGINS=http://localhost:3000,http://staging.example.com
# TODO(user): replace with your production frontend domain, e.g.
# CORS_ORIGIN_PROD=https://luminaedit.example.com
CORS_ORIGIN_PROD=https://example.com

# ============================================================================
# REDIS & BULLMQ (queue for AI microservice requests)
# ============================================================================
# Required. The queue and rate limiters share this Redis instance.
# In docker-compose this is the "redis" service hostname; locally use localhost.
REDIS_URL=redis://127.0.0.1:6379

# Concurrency cap for AI jobs. The server has 2 vCPU so the safe ceiling is 2.
# The Python microservice runs 1 internal worker (configured there) — a value
# of 2 lets the Node side enqueue two requests immediately, but only one will
# actually execute server-side; the second will queue inside Python.
# Override at 2 in production. Set to 1 if you want stricter back-pressure.
AI_WORKER_CONCURRENCY=2

# Per-job timeout. If the AI microservice does not respond within this window
# the job is failed with code "AI_TIMEOUT" and the user can retry.
AI_JOB_TIMEOUT_MS=10000

# Number of retry attempts on transient AI failures (network blips, 5xx)
AI_JOB_MAX_RETRIES=2

# How long completed/failed job records are kept in Redis (seconds).
# 24h is plenty for the frontend to poll "done" results.
AI_JOB_RESULT_TTL_SECONDS=86400

# Max waiting (not yet started) AI jobs before new submissions get 503 QUEUE_FULL.
AI_QUEUE_MAX_WAITING=100

# Run the BullMQ AI worker inside the API process (handy for local dev).
# Production runs `npm run worker` as a separate process instead.
RUN_WORKER_INPROCESS=1

# ============================================================================
# RATE LIMITING (per-IP, Redis-backed so multiple Node processes share limits)
# ============================================================================
# AI endpoints: max N requests per WINDOW_MIN per IP.
# 10/10min is the default — generous enough that real users never hit it,
# tight enough to stop abuse.
AI_RATE_LIMIT_MAX=10
AI_RATE_LIMIT_WINDOW_MIN=10

# Light endpoints (resize/crop/compress/convert): higher cap, longer window.
LIGHT_RATE_LIMIT_MAX=100
LIGHT_RATE_LIMIT_WINDOW_MIN=60

# When behind a load balancer / nginx, set TRUST_PROXY=1 to honor X-Forwarded-For.
# Set to 0 (or leave blank) when running directly on the host.
TRUST_PROXY=1
